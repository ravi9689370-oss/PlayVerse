# PlayVerse environment configuration example.
# The application runs fully client-side; no secrets are required.
# Copy to .env and adjust only if you change branding or add analytics.

# Display name used in the UI (defaults to PlayVerse in code if unset)
VITE_SITE_NAME=PlayVerse

# Base URL used in canonical meta tags (no trailing slash)
VITE_SITE_URL=https://example.com
